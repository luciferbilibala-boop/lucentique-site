---
import Figure from './Figure.astro';

interface GalleryImage {
  src: string;
  alt?: string;
  altText?: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

{
  images && images.length > 0 && (
    <div class="image-gallery">
      {images.map((img, i) => (
        <Figure
          src={img.src}
          alt={img.altText || img.alt || `图 ${i + 1}`}
          caption={img.caption}
        />
      ))}
    </div>
  )
}

<style>
  .image-gallery {
    margin: var(--space-lg) 0;
  }
</style>
