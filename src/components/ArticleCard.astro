---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'a_class'> | CollectionEntry<'b_class'>;
  section: 'a' | 'b';
}

const { entry, section } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
const hasCover = !!entry.data.cover;
const availability = 'availability' in entry.data ? entry.data.availability as string | undefined : undefined;
---

<article class="card" class:list={{ 'card--text-only': !hasCover }}>
  <a href={`${base}${section}/${entry.id}/`} class="card-link">
    {hasCover && (
      <div class="card-image">
        <img src={`${base}${entry.data.cover.replace(/^\//, '')}`} alt={entry.data.coverAltText || entry.data.title} loading="lazy" />
        {availability && (
          <span class="card-badge" class:list={{ 'badge--available': availability === '在售', 'badge--sold': availability === '已售' }}>
            {availability}
          </span>
        )}
      </div>
    )}
    <div class="card-body">
      <time class="card-date" datetime={entry.data.date.toISOString()}>
        {entry.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <h2 class="card-title">{entry.data.title}</h2>
      {entry.data.description && (
        <p class="card-desc">{entry.data.description}</p>
      )}
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: border-color 0.2s ease;
  }

  .card:hover {
    border-color: var(--color-accent-light);
  }

  .card--text-only {
    background: var(--color-bg);
  }

  .card-link {
    display: block;
    border-bottom: none;
  }

  .card-link:hover {
    border-bottom: none;
  }

  .card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg);
    position: relative;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    padding: var(--space-md);
  }

  .card--text-only .card-body {
    padding: var(--space-lg) var(--space-md);
    min-height: 160px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-date {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-text-light);
    display: block;
    margin-bottom: 0.4rem;
  }

  .card-title {
    font-size: 1.1rem;
    margin: 0;
    line-height: 1.4;
  }

  .card-desc {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
    margin-bottom: 0;
    line-height: 1.5;
  }

  .card-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    color: #fff;
  }

  .badge--available {
    background: #6b9b5f;
  }

  .badge--sold {
    background: var(--color-text-light);
  }
</style>
