---
const base = import.meta.env.BASE_URL || '/';
---

<header class="site-header">
  <div class="header-inner container-wide">
    <a href={base} class="site-brand">
      <img
        src={`${base}brand/logo-header.png`}
        srcset={`${base}brand/logo-header@2x.png 2x`}
        alt="LUCENTIQUE"
        class="brand-logo"
      />
      <span class="brand-text">LUCENTIQUE<wbr />古籍藏</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <a href={`${base}a/`}>藏品</a>
      <span class="nav-sep">·</span>
      <a href={`${base}b/`}>老灵魂</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .site-brand {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 0.9rem;
    border-bottom: none;
    text-decoration: none;
    line-height: 1;
    min-width: 0;
  }

  .brand-logo {
    height: 28px;
    width: auto;
    display: block;
    flex-shrink: 0;
  }

  .brand-text {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.28rem;
    letter-spacing: 0.04em;
    color: var(--color-text);
    white-space: nowrap;
  }

  .site-nav {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  @media (max-width: 520px) {
    .header-inner {
      align-items: center;
      flex-direction: row;
      gap: var(--space-sm);
    }

    .site-nav {
      width: 100%;
      justify-content: center;
    }
  }

  .site-nav a {
    border-bottom: none;
    color: var(--color-text-muted);
  }

  .site-nav a:hover {
    color: var(--color-text);
    border-bottom: none;
  }

  .nav-sep {
    color: var(--color-border);
  }
</style>
