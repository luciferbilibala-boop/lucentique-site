---
const base = import.meta.env.BASE_URL || '/';
---

<footer class="site-footer">
  <div class="container-wide footer-inner">
    <a href={base} class="footer-logo">
      <img
        src={`${base}brand/logo-footer.png`}
        alt="LUCENTIQUE"
      />
    </a>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xl);
  }

  .footer-inner {
    text-align: center;
  }

  .footer-logo {
    display: inline-block;
    border-bottom: none;
  }

  .footer-logo img {
    display: block;
    height: 48px;
    width: auto;
    margin: 0 auto;
  }
</style>
