---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  pageTitle?: string;
  pageDescription?: string;
  pageImage?: string;
  pageUrl?: string;
  pageType?: 'article' | 'book' | 'website';
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
}
---

<Base {...Astro.props}>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</Base>
