---
import Page from './Page.astro';
import ImageGallery from '../components/ImageGallery.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'a_class'> | CollectionEntry<'b_class'>;
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
const hasGallery = entry.data.gallery && entry.data.gallery.length > 0;
const coverSrc = entry.data.cover ? `${base}${entry.data.cover.replace(/^\//, '')}` : null;
const galleryImages = entry.data.gallery?.map(img => ({
  ...img,
  src: `${base}${img.src.replace(/^\//, '')}`,
}));
---

<Page>
  <article class="container">
    <header class="article-header">
      <div class="article-meta">
        <time datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {
          entry.data.tags && entry.data.tags.length > 0 && (
            <span class="article-tags">
              {entry.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
            </span>
          )
        }
      </div>
      <h1>{entry.data.title}</h1>
      {entry.data.description && (
        <p class="article-desc">{entry.data.description}</p>
      )}
    </header>

    {coverSrc && (
      <div class="article-cover">
        <img src={coverSrc} alt={entry.data.title} />
      </div>
    )}

    <div class="article-content">
      <slot />

      {hasGallery && galleryImages && (
        <>
          <hr />
          <ImageGallery images={galleryImages} />
        </>
      )}
    </div>
  </article>
</Page>

<style>
  .article-header {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }

  .article-header h1 {
    margin-bottom: var(--space-sm);
  }

  .article-meta {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .article-desc {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-top: var(--space-sm);
  }

  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--color-text-light);
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .article-cover {
    margin-bottom: var(--space-lg);
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-content {
    padding-bottom: var(--space-xl);
    max-width: var(--max-width);
  }
</style>
