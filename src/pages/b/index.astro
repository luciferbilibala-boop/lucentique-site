---
import { getCollection } from 'astro:content';
import List from '../../layouts/List.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const entries = await getCollection('b_class', ({ data }) => data.published === true);
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const siteUrl = (Astro.site?.href || '').replace(/\/$/, '');
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

const listJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '少女心中有一个老灵魂',
  description: '分享艺术、书籍、审美与古典生活方式。',
  url: `${siteUrl}${basePath}/b/`,
  mainEntity: {
    '@type': 'Blog',
    name: 'LUCENTIQUE 老灵魂',
    blogPost: entries.map(e => ({
      '@type': 'BlogPosting',
      headline: e.data.title,
      url: `${siteUrl}${basePath}/b/${e.id}/`,
      datePublished: e.data.date.toISOString(),
      ...(e.data.description ? { description: e.data.description } : {}),
      ...(e.data.cover ? { image: `${siteUrl}${basePath}${e.data.cover}` } : {}),
    })),
  },
};
---

<List
  section="b"
  title="少女心中有一个老灵魂"
  description="分享艺术、书籍、审美与古典生活方式。"
  pageTitle="少女心中有一个老灵魂"
  pageDescription="分享艺术、书籍、审美与古典生活方式。"
  pageUrl="/b/"
  pageType="website"
  jsonLd={listJsonLd}
>
  {entries.map((entry) => <ArticleCard entry={entry} section="b" />)}
</List>
