---
import { getCollection } from 'astro:content';
import List from '../../layouts/List.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const entries = await getCollection('a_class', ({ data }) => data.published === true);
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const siteUrl = (Astro.site?.href || '').replace(/\/$/, '');
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

const listJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '古籍藏品',
  description: 'LUCENTIQUE 古籍收藏与在售藏品。',
  url: `${siteUrl}${basePath}/a/`,
  mainEntity: {
    '@type': 'ItemList',
    name: '古籍藏品',
    itemListElement: entries.map((e, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Book',
        name: e.data.title,
        url: `${siteUrl}${basePath}/a/${e.id}/`,
        ...(e.data.description ? { description: e.data.description } : {}),
        ...(e.data.cover ? { image: `${siteUrl}${basePath}${e.data.cover}` } : {}),
      },
    })),
  },
};
---

<List
  section="a"
  title="古籍藏品"
  description="LUCENTIQUE 古籍收藏与在售藏品。"
  pageTitle="古籍藏品"
  pageDescription="LUCENTIQUE 古籍收藏与在售藏品。"
  pageUrl="/a/"
  pageType="website"
  jsonLd={listJsonLd}
>
  {entries.map((entry) => <ArticleCard entry={entry} section="a" />)}
</List>
